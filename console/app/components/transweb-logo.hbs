{{!--
    Theme-aware Transweb wordmark.
    If the organisation uploaded its own logo (Admin → Branding), show that; otherwise show the
    navy wordmark on light backgrounds and the white wordmark on dark ones.
--}}
{{#if this.customLogoUrl}}
    <Image src={{this.customLogoUrl}} @fallbackSrc="/images/transweb-logo.svg" alt={{t "app.name"}} class={{@class}} />
{{else}}
    <img src="/images/transweb-logo.svg" alt={{t "app.name"}} class="block dark:hidden {{@class}}" />
    <img src="/images/transweb-logo-on-dark.svg" alt={{t "app.name"}} class="hidden dark:block {{@class}}" />
{{/if}}
