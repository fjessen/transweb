# Copy to the project root as `.env` on the server (it is gitignored) and fill in.
# deploy/server-setup.sh does this for you and generates the passwords.

# Makes plain `docker compose ...` use the production override
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# Public hostnames. Without a registered domain, use sslip.io on the VM's static IP,
# e.g. for 34.77.10.20:  app.34-77-10-20.sslip.io  /  api.34-77-10-20.sslip.io
APP_DOMAIN=
API_DOMAIN=

# Let's Encrypt registration / expiry notices
ACME_EMAIL=

# MySQL (generated by server-setup.sh). Only used when the database volume is first created;
# changing them later does NOT change the passwords inside MySQL.
DB_ROOT_PASSWORD=
DB_PASSWORD=

# Routing server (replace with your self-hosted OSRM later)
OSRM_HOST=https://router.project-osrm.org

# Off-server backups (set by migrate-from-local.sh), e.g. gs://<project>-transweb-backups
BACKUP_BUCKET=
